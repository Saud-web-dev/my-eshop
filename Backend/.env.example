PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/your_database_name

# JWT
JWT_SECRET=replace_with_a_secure_64_character_random_string
JWT_REFRESH_SECRET=replace_with_a_different_secure_64_character_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=replace_with_a_secure_random_string

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Email (Gmail App Password; required in production)
# Enable 2-Step Verification and generate an App Password in your Google Account.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=replace_with_16_character_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Your Store
# Optional contact-form recipient. Defaults to the store email in Settings, then EMAIL_USER.
CONTACT_EMAIL=

# OTP expiry in seconds (5 minutes)
OTP_EXPIRY=300

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_secret

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# One-time admin bootstrap only
ADMIN_SETUP_KEY=replace_with_a_long_random_admin_setup_key
